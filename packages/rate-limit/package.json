{
  "name": "@green-tea/rate-limit",
  "version": "26.9.0-beta.0",
  "private": true,
  "description": "A per-request rate limiter published into the green-tea graph, with a branded 429 and a swept in-memory store.",
  "license": "MIT",
  "author": "green-tea contributors <projects@expressive-tea.io>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Expressive-Tea/green-tea-plugins.git",
    "directory": "packages/rate-limit"
  },
  "engines": {
    "node": ">=22",
    "deno": ">=2",
    "bun": ">=1.3"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@green-tea/core": "26.9.0-beta.2"
  }
}
